# Keep files consistent across editors so diffs stay about content, not whitespace.
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space

[*.py]
indent_size = 4
max_line_length = 88

[*.{yml,yaml,toml,json}]
indent_size = 2

[*.md]
indent_size = 2
# Markdown uses trailing double-space for a hard line break.
trim_trailing_whitespace = false
